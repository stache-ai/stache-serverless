{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormation",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:*:*:stack/*-serverless/*",
        "arn:aws:cloudformation:*:*:stack/*-agentcore/*",
        "arn:aws:cloudformation:*:*:stack/*-certificate/*",
        "arn:aws:cloudformation:*:*:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:*:aws:transform/*"
      ]
    },
    {
      "Sid": "S3",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::aws-sam-cli-managed-default-*",
        "arn:aws:s3:::aws-sam-cli-managed-default-*/*",
        "arn:aws:s3:::*-frontend-*",
        "arn:aws:s3:::*-frontend-*/*",
        "arn:aws:s3:::*-vectors-*"
      ]
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:*:*:function:*-api",
        "arn:aws:lambda:*:*:function:*-agentcore",
        "arn:aws:lambda:*:*:layer:*"
      ]
    },
    {
      "Sid": "APIGateway",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": [
        "arn:aws:apigateway:*::/restapis",
        "arn:aws:apigateway:*::/restapis/*",
        "arn:aws:apigateway:*::/apis",
        "arn:aws:apigateway:*::/apis/*",
        "arn:aws:apigateway:*::/v2/apis",
        "arn:aws:apigateway:*::/v2/apis/*",
        "arn:aws:apigateway:*::/tags/*"
      ]
    },
    {
      "Sid": "DynamoDB",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": [
        "arn:aws:dynamodb:*:*:table/*-namespaces",
        "arn:aws:dynamodb:*:*:table/*-documents"
      ]
    },
    {
      "Sid": "Cognito",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "arn:aws:cognito-idp:*:*:userpool/*"
    },
    {
      "Sid": "IAM",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::*:role/*-serverless-*",
        "arn:aws:iam::*:role/*-agentcore-*",
        "arn:aws:iam::*:policy/*-serverless-*"
      ]
    },
    {
      "Sid": "SQS",
      "Effect": "Allow",
      "Action": "sqs:*",
      "Resource": "arn:aws:sqs:*:*:*-lambda-dlq"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/lambda/*-api:*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/*-agentcore:*"
      ]
    },
    {
      "Sid": "CloudWatch",
      "Effect": "Allow",
      "Action": "cloudwatch:*",
      "Resource": [
        "arn:aws:cloudwatch:*:*:alarm:*-serverless-*",
        "arn:aws:cloudwatch:*:*:alarm:*-api-*",
        "arn:aws:cloudwatch:*:*:alarm:*-agentcore-*"
      ]
    },
    {
      "Sid": "S3Vectors",
      "Effect": "Allow",
      "Action": "s3vectors:*",
      "Resource": [
        "arn:aws:s3vectors:*:*:vector-bucket/*-vectors-*",
        "arn:aws:s3vectors:*:*:vector-bucket/*-vectors-*/index/*"
      ]
    },
    {
      "Sid": "GlobalServices",
      "Effect": "Allow",
      "Action": [
        "cloudfront:*",
        "acm:*",
        "bedrock-agentcore:*"
      ],
      "Resource": "*"
    }
  ]
}
